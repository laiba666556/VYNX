# VYNX configuration template — copy to .env and fill in what you need.
# .env is gitignored; this example file is safe to commit.
# These are the ONLY variables the code reads; everything else is hardcoded.

# AI second-opinion layer (Alibaba DashScope).
# Leave QWEN_API_KEY empty to run in rule-engine-only mode (fully functional).
QWEN_API_KEY=
QWEN_MODEL=qwen-plus


# CORS allow-list for the backend (comma-separated origins).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
